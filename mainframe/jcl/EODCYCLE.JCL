//TBEODCYC JOB (ACCT4711),'TESSERA EOD CYCLE',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*
//********************************************************************
//* TESSERA BANK - END OF DAY ACCOUNT CYCLE                          *
//*                                                                  *
//* RUNS NIGHTLY AFTER THE INTEGRATION TIER HAS DELIVERED THE DAY'S  *
//* MOVEMENT FILE.  SORTS THE MOVEMENTS, APPLIES THEM TO THE ACCOUNT *
//* MASTER, SORTS THE NEW MASTER INTO REPORT SEQUENCE, AND PRINTS    *
//* THE END OF DAY REPORT.                                           *
//*                                                                  *
//* THIS DECK IS NOT EXECUTED IN THIS REPOSITORY - GNUCOBOL CANNOT   *
//* RUN JCL.  IT IS THE REAL-WORLD ARTEFACT, AND MAINFRAME/JCL/      *
//* RUN-EOD.SH IS THE EXECUTABLE EQUIVALENT.  THE TWO DESCRIBE THE   *
//* SAME FOUR STEPS AND TEST-EOD-CYCLE.PY FAILS IF THEY DIVERGE.     *
//*                                                                  *
//* RESTART: FROM THE FAILING STEP.  NO STEP UPDATES THE MASTER IN   *
//* PLACE - STEP020 WRITES A NEW GENERATION - SO A RESTART REAPPLIES *
//* NOTHING.  SEE DOCS/RUNBOOKS/EOD-CYCLE.MD.                        *
//********************************************************************
//*
//* ------------------------------------------------------------------
//* STEP010 - SORT THE DELIVERED MOVEMENTS INTO ACCOUNT SEQUENCE.
//* THE MATCH-MERGE IN STEP020 REQUIRES BOTH INPUTS IN THE SAME ORDER.
//* THE FEED IS NOT TRUSTED TO ARRIVE SORTED.
//* ------------------------------------------------------------------
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=TESSERA.EOD.MOVEMENT.IN,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27600)
//SORTOUT  DD DSN=TESSERA.EOD.MOVEMENT.DAT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27600)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(50,10))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(50,10))
//SYSIN    DD *
  SORT FIELDS=(23,16,CH,A)
  OPTION EQUALS
/*
//*
//* ------------------------------------------------------------------
//* STEP020 - APPLY THE DAY'S MOVEMENTS TO THE ACCOUNT MASTER.
//* THE BALANCED-LINE MATCH-MERGE.  WRITES A NEW MASTER GENERATION AND
//* A REJECTS FILE; THE OLD MASTER IS NEVER UPDATED IN PLACE.
//* ------------------------------------------------------------------
//STEP020  EXEC PGM=ACCTPOST,COND=(0,LT)
//STEPLIB  DD DSN=TESSERA.CORE.LOADLIB,DISP=SHR
//SYSOUT   DD SYSOUT=*
//ACCTMAST DD DSN=TESSERA.ACCT.MASTER(0),DISP=SHR,
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//MOVEMENT DD DSN=TESSERA.EOD.MOVEMENT.DAT,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27600)
//ACCTNEW  DD DSN=TESSERA.ACCT.MASTER(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(200,50),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//REJECTS  DD DSN=TESSERA.EOD.REJECTS.DAT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//*
//* ------------------------------------------------------------------
//* STEP030 - SORT THE NEW MASTER INTO REPORT SEQUENCE.
//* EODREPT CONTROL-BREAKS ON CURRENCY, WHICH REQUIRES THE FILE IN
//* CURRENCY ORDER.  A REPORT PROGRAM THAT SORTS FOR ITSELF IS A
//* REPORT PROGRAM THAT HOLDS THE MASTER IN MEMORY.
//* ------------------------------------------------------------------
//STEP030  EXEC PGM=SORT,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=TESSERA.ACCT.MASTER(+1),DISP=SHR,
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//SORTOUT  DD DSN=TESSERA.EOD.ACCTRPT.DAT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(200,50),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(200,50))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(200,50))
//SYSIN    DD *
  SORT FIELDS=(38,3,CH,A,1,16,CH,A)
  OPTION EQUALS
/*
//*
//* ------------------------------------------------------------------
//* STEP040 - PRINT THE END OF DAY REPORT.
//* CTLREJ CARRIES STEP020'S REJECT COUNT SO THE REPORT RECONCILES
//* AGAINST THE RUN THAT PRODUCED IT.  A MISMATCH ENDS THE STEP WITH
//* RC=12 AND THE CYCLE FAILS.
//* ------------------------------------------------------------------
//STEP040  EXEC PGM=EODREPT,COND=(0,LT)
//STEPLIB  DD DSN=TESSERA.CORE.LOADLIB,DISP=SHR
//SYSOUT   DD SYSOUT=*
//ACCTRPT  DD DSN=TESSERA.EOD.ACCTRPT.DAT,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//REJECTS  DD DSN=TESSERA.EOD.REJECTS.DAT,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//EODREPT  DD SYSOUT=A,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=13300)
//*
//         IF (STEP040.RC = 0) THEN
//* ------------------------------------------------------------------
//* THE CYCLE ENDED CLEAN.  THE REJECTS FILE GOES TO THE BACK OFFICE
//* QUEUE, WHERE AN OPERATOR WORKS EACH REJECTED MOVEMENT BY HAND.
//* ------------------------------------------------------------------
//NOTIFY   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=TESSERA.EOD.REJECTS.DAT,DISP=SHR
//SYSUT2   DD DSN=TESSERA.BACKOFFICE.REJECTS(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SYSIN    DD DUMMY
//         ELSE
//* ------------------------------------------------------------------
//* A STEP FAILED.  NOTHING DOWNSTREAM RUNS AND THE MASTER GENERATION
//* IS LEFT UNCATALOGUED.  ESCALATE PER THE RUNBOOK.
//* ------------------------------------------------------------------
//FAILED   EXEC PGM=IEFBR14
//         ENDIF
//
