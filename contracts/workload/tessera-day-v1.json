    "windows": [
      {
        "id": "overnight-batch",
        "startMinute": 1230,
        "endMinute": 300,
        "purpose": "EODCYCLE runs against the movement file the online day produced. Wraps midnight, which is why endMinute is not after startMinute."
      },
      {
        "id": "morning-reconciliation",
        "startMinute": 300,
        "endMinute": 420,
        "purpose": "batch/recon compares the account master the cycle wrote against the ledger, and the back office works whatever it found before the branches open."
      },
      {
        "id": "branch-hours",
        "startMinute": 540,
        "endMinute": 1080,
        "purpose": "Staffed hours. Named so a driver can report separately on demand an operator was present for."
      }
    ],

    "instants": [
      {
        "id": "online-cut-off",
        "atMinute": 1200,
        "purpose": "20:00. The moment the online day stops feeding the batch. This is a point on the demand curve and NOT the reconciliation cut-off, which ADR 0015 defines as the set of MOV-TRANSFER-REF values in the movement file rather than as any time of day."
      }
    ]
  },

