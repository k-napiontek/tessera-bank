{
  "modelId": "TB-WORKLOAD-DAY-V1",
  "modelVersion": "1.0.0",
  "summary": "One business day at a mid-size Polish retail bank: a night trough, a morning ramp, a lunch peak, a second peak as the working day closes, an online cut-off at 20:00, the overnight batch, and reconciliation before the branches open.",

