<?xml version="1.0" encoding="UTF-8"?>
<!--
  Canonical XML types for the Tessera Bank estate.

  Derived from docs/architecture/canonical-data-model.md. Every type below traces to a concept
  defined there; nothing is invented here. Where this schema and the model disagree, the model is
  corrected first and this schema follows.

  XSD 1.0 deliberately: this is the 2011 stratum, and XSD 1.1 assertions did not exist in the
  toolchain a bank of that vintage had. Constraints that cannot be expressed in 1.0 are enforced by
  the contract tests instead, not silently dropped.

  Consumed by legacy/customer-master (SOAP) and integration/esb-adapter (canonical XML, by XSLT).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tb="http://schemas.tesserabank.example/canonical/v1"
           targetNamespace="http://schemas.tesserabank.example/canonical/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- ============================================================ -->
  <!-- Identifiers                                                  -->
  <!-- ============================================================ -->

  <xs:simpleType name="AccountRefType">
    <xs:annotation>
      <xs:documentation>Estate-wide account key. Immutable for the life of the account.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="16"/>
      <xs:pattern value="TB[0-9A-Z]{14}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CustomerRefType">
    <xs:annotation>
      <xs:documentation>
        Pseudonymous link to customer-master. Never a name, never a national identifier.
        Pseudonymised data is still personal data under GDPR.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="12"/>
      <xs:pattern value="CU[0-9]{10}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TransferRefType">
    <xs:annotation>
      <xs:documentation>TB, then CCYYMMDD, then a ten-digit sequence.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="20"/>
      <xs:pattern value="TB[0-9]{18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MovementRefType">
    <xs:annotation>
      <xs:documentation>The transfer reference, a hyphen, then the two-digit leg number.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="23"/>
      <xs:pattern value="TB[0-9]{18}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CorrelationIdType">
    <xs:restriction base="xs:string">
      <xs:length value="36"/>
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================ -->
  <!-- Money                                                        -->
  <!-- ============================================================ -->

  <xs:simpleType name="CurrencyCodeType">
    <xs:annotation>
      <xs:documentation>ISO 4217 alpha-3, uppercase. The scale table in the model resolves the decimals.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="3"/>
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AmountMinorType">
    <xs:annotation>
      <xs:documentation>
        Signed count of minor units. Never a decimal, never a float. 123456789 with currency PLN
        is 1 234 567.89. Fifteen digits, matching PIC S9(13)V99 COMP-3 at stratum 0.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:long">
      <xs:totalDigits value="15"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="MoneyType">
    <xs:annotation>
      <xs:documentation>
        An amount is meaningless without its currency, so the two are never separated. Two amounts
        are comparable only when their currencies are equal; there is no implicit conversion.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="amountMinor" type="tb:AmountMinorType"/>
      <xs:element name="currency" type="tb:CurrencyCodeType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================================================ -->
  <!-- Enumerations                                                 -->
  <!-- ============================================================ -->

  <xs:simpleType name="AccountTypeType">
    <xs:annotation>
      <xs:documentation>
        A customer current account is a LIABILITY of the bank. Cash and reserves are ASSETs.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ASSET"/>
      <xs:enumeration value="LIABILITY"/>
      <xs:enumeration value="EQUITY"/>
      <xs:enumeration value="REVENUE"/>
      <xs:enumeration value="EXPENSE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AccountStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OPEN"/>
      <xs:enumeration value="BLOCKED"/>
      <xs:enumeration value="CLOSED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DirectionType">
    <xs:annotation>
      <xs:documentation>Direction carries the sign. The amount itself is always positive.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="DEBIT"/>
      <xs:enumeration value="CREDIT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TransferStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACCEPTED"/>
      <xs:enumeration value="POSTED"/>
      <xs:enumeration value="REJECTED"/>
      <xs:enumeration value="REVERSED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LegNoType">
    <xs:annotation>
      <xs:documentation>1 is the debit leg, 2 the credit leg.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="99"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReferenceType">
    <xs:annotation>
      <xs:documentation>
        Remittance information, 35 characters as in the SEPA field. Must never carry personal data.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="35"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================================ -->
  <!-- Concepts                                                     -->
  <!-- ============================================================ -->

  <xs:complexType name="Account">
    <xs:sequence>
      <xs:element name="accountRef" type="tb:AccountRefType"/>
      <xs:element name="customerRef" type="tb:CustomerRefType"/>
      <xs:element name="accountType" type="tb:AccountTypeType"/>
      <xs:element name="currency" type="tb:CurrencyCodeType"/>
      <xs:element name="status" type="tb:AccountStatusType"/>
      <xs:element name="bookedBalance" type="tb:MoneyType"/>
      <xs:element name="availableBalance" type="tb:MoneyType"/>
      <xs:element name="openedDate" type="xs:date"/>
      <xs:element name="lastMovementDate" type="xs:date" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Movement">
    <xs:annotation>
      <xs:documentation>One leg of a double-entry posting. Immutable once written.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="movementRef" type="tb:MovementRefType"/>
      <xs:element name="transferRef" type="tb:TransferRefType"/>
      <xs:element name="legNo" type="tb:LegNoType"/>
      <xs:element name="accountRef" type="tb:AccountRefType"/>
      <xs:element name="direction" type="tb:DirectionType"/>
      <xs:element name="amount" type="tb:MoneyType"/>
      <xs:element name="valueDate" type="xs:date"/>
      <xs:element name="postedAt" type="xs:dateTime"/>
      <xs:element name="reference" type="tb:ReferenceType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Transfer">
    <xs:sequence>
      <xs:element name="transferRef" type="tb:TransferRefType"/>
      <xs:element name="debitAccountRef" type="tb:AccountRefType"/>
      <xs:element name="creditAccountRef" type="tb:AccountRefType"/>
      <xs:element name="amount" type="tb:MoneyType"/>
      <xs:element name="status" type="tb:TransferStatusType"/>
      <xs:element name="reference" type="tb:ReferenceType" minOccurs="0"/>
      <xs:element name="requestedAt" type="xs:dateTime"/>
      <xs:element name="postedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="reversesTransferRef" type="tb:TransferRefType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Present only when this transfer reverses another. A correction is always a new transfer
            referencing the original, never a mutation of it.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="correlationId" type="tb:CorrelationIdType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================================================ -->
  <!-- The canonical transfer message                               -->
  <!-- ============================================================ -->

  <xs:element name="canonicalTransfer">
    <xs:annotation>
      <xs:documentation>
        What integration/esb-adapter transforms the Kafka event into by XSLT, before calling SOAP and
        encoding the fixed-width movement records.

        Exactly two movements: the schema enforces double entry rather than trusting the producer.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="transfer" type="tb:Transfer"/>
        <xs:element name="movement" type="tb:Movement" minOccurs="2" maxOccurs="2"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="account" type="tb:Account"/>
  <xs:element name="movement" type="tb:Movement"/>

</xs:schema>
